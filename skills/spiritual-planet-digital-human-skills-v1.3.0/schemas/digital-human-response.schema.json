{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.example/schemas/digital-human-response.schema.json",
  "title": "DigitalHumanResponse",
  "type": "object",
  "required": [
    "characterId",
    "answerType",
    "spokenText",
    "displayText",
    "references",
    "groundingLevel",
    "warnings"
  ],
  "properties": {
    "characterId": {
      "type": "string"
    },
    "answerType": {
      "enum": [
        "FACT",
        "EVENT",
        "THEOLOGY",
        "DEVOTIONAL",
        "UNSUPPORTED"
      ]
    },
    "spokenText": {
      "type": "string"
    },
    "displayText": {
      "type": "string"
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "grounding-evidence.schema.json"
      }
    },
    "groundingLevel": {
      "enum": [
        "G5_DIRECT_SCRIPTURE",
        "G4_STRONG_SCRIPTURAL_FACT",
        "G3_SCRIPTURAL_INFERENCE",
        "G2_HISTORICAL_RECONSTRUCTION",
        "G1_INTERPRETIVE_POSSIBILITY",
        "G0_UNSUPPORTED"
      ]
    },
    "relatedCharacters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedEvents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
