{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.local/schemas/batch-01-44-evidence-envelope.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch", "skill", "claim", "corpus_role", "producer", "environment", "subject", "assurance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "batch": {"type": "integer", "minimum": 1, "maximum": 44},
    "skill": {"type": "string", "minLength": 1, "maxLength": 64},
    "claim": {"type": "object"},
    "corpus_role": {"enum": ["development", "negative", "holdout", "representative", "production"]},
    "producer": {"type": "object"},
    "environment": {"type": "object"},
    "subject": {"type": "object"},
    "assurance": {"type": "object"}
  }
}
