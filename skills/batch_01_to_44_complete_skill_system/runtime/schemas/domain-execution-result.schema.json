{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.local/schemas/batch-01-44-domain-execution-result.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch", "skill", "executor_id", "claim", "corpus", "source_fingerprint", "environment", "domain_contract", "skill_contract", "toolchain", "assertions", "raw_evidence", "decision", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "batch": {"type": "integer", "minimum": 1, "maximum": 44},
    "skill": {"type": "string", "minLength": 1, "maxLength": 64},
    "executor_id": {"type": "string", "minLength": 1},
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "index", "sha256"],
      "properties": {
        "type": {"enum": ["output", "test", "external"]},
        "index": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "corpus": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "id", "sha256", "independent"],
      "properties": {
        "role": {"enum": ["development", "negative", "holdout", "representative", "production"]},
        "id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "independent": {"type": "boolean"}
      }
    },
    "source_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["local", "clean", "holdout", "representative", "sandbox", "production"]},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "domain_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handler", "contract_version", "operation", "capabilities", "safety_controls"],
      "properties": {
        "handler": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "contract_version": {"const": "1.0"},
        "operation": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
        "safety_controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}}
      }
    },
    "skill_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "handler_id", "operation", "source_path", "source_sha256", "objective_sha256", "input_sha256", "output_sha256", "workflow_sha256", "test_sha256", "stop_sha256", "risk", "effect_class", "required_evidence_role"],
      "properties": {
        "contract_version": {"const": "1.0"},
        "handler_id": {"type": "string", "pattern": "^ss-b[0-9]{2}-[0-9a-f]{20}-handler-v1$"},
        "operation": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9-]+$"},
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "objective_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "input_sha256": {"$ref": "#/$defs/digestArray"},
        "output_sha256": {"$ref": "#/$defs/digestArray"},
        "workflow_sha256": {"$ref": "#/$defs/digestArray"},
        "test_sha256": {"$ref": "#/$defs/digestArray"},
        "stop_sha256": {"$ref": "#/$defs/digestArray"},
        "risk": {"enum": ["low", "medium", "high", "critical"]},
        "effect_class": {"enum": ["read-only", "reversible", "approval-required"]},
        "required_evidence_role": {"type": "string", "pattern": "^skill:ss-b[0-9]{2}-[0-9a-f]{20}-handler-v1:execution$"}
      }
    },
    "toolchain": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "version", "argv_sha256", "exit_code", "evidence_role"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "argv_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "exit_code": {"type": "integer"},
          "evidence_role": {"type": "string", "minLength": 1}
        }
      }
    },
    "assertions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "outcome", "detail"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "BLOCKED", "NOT_RUN"]},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "raw_evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "decision": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "BLOCKED", "NOT_RUN"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "digestArray": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    }
  }
}
