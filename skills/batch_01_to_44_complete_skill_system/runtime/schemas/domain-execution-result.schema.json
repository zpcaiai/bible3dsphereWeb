{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.local/schemas/batch-01-44-domain-execution-result.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch", "skill", "executor_id", "claim", "corpus", "source_fingerprint", "environment", "toolchain", "assertions", "raw_evidence", "decision", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "batch": {"type": "integer", "minimum": 1, "maximum": 44},
    "skill": {"type": "string", "minLength": 1, "maxLength": 64},
    "executor_id": {"type": "string", "minLength": 1},
    "claim": {"type": "object"},
    "corpus": {"type": "object"},
    "source_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "environment": {"type": "object"},
    "toolchain": {"type": "array", "minItems": 1},
    "assertions": {"type": "array", "minItems": 1},
    "raw_evidence": {"type": "array", "minItems": 1},
    "decision": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "BLOCKED", "NOT_RUN"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
