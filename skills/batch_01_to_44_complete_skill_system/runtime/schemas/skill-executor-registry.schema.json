{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.local/schemas/skill-executor-registry.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "namespace", "skill_executor_count", "entries", "status_boundary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "namespace": {"const": "batch-01-44-complete-skill-system"},
    "skill_executor_count": {"const": 788},
    "entries": {
      "type": "array", "minItems": 788, "maxItems": 788,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["batch", "skill", "handler_id", "source_package", "contract", "repository_commands_allowed", "requires_actual_toolchain", "requires_raw_evidence", "status_boundary"],
        "properties": {
          "batch": {"type": "integer", "minimum": 1, "maximum": 44},
          "skill": {"type": "string", "minLength": 1, "maxLength": 64},
          "handler_id": {"type": "string", "pattern": "^ss-b[0-9]{2}-[0-9a-f]{20}-handler-v1$"},
          "source_package": {"type": "string", "minLength": 1},
          "contract": {"$ref": "#/$defs/contract"},
          "repository_commands_allowed": {"const": false},
          "requires_actual_toolchain": {"const": true},
          "requires_raw_evidence": {"const": true},
          "status_boundary": {"type": "string", "minLength": 1}
        }
      }
    },
    "status_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digestArray": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}},
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "handler_id", "operation", "source_path", "source_sha256", "objective_sha256", "input_sha256", "output_sha256", "workflow_sha256", "test_sha256", "stop_sha256", "risk", "effect_class", "required_evidence_role"],
      "properties": {
        "contract_version": {"const": "1.0"},
        "handler_id": {"type": "string", "pattern": "^ss-b[0-9]{2}-[0-9a-f]{20}-handler-v1$"},
        "operation": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "objective_sha256": {"$ref": "#/$defs/digest"},
        "input_sha256": {"$ref": "#/$defs/digestArray"},
        "output_sha256": {"$ref": "#/$defs/digestArray"},
        "workflow_sha256": {"$ref": "#/$defs/digestArray"},
        "test_sha256": {"$ref": "#/$defs/digestArray"},
        "stop_sha256": {"$ref": "#/$defs/digestArray"},
        "risk": {"enum": ["low", "medium", "high", "critical"]},
        "effect_class": {"enum": ["read-only", "reversible", "approval-required"]},
        "required_evidence_role": {"type": "string", "pattern": "^skill:ss-b[0-9]{2}-[0-9a-f]{20}-handler-v1:execution$"}
      }
    }
  }
}
